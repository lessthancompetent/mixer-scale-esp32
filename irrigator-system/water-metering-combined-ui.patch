+  const name =document.getElementById('irr-new-name').value||`Run ${new Date().toLocaleDateString()}`;
+  const width=parseFloat(document.getElementById('irr-new-width').value)||30;
+  const flow =parseFloat(document.getElementById('irr-new-flow').value)||833;
+  const ok=await irrApi('/sessions',{
+    method:'POST',headers:{'Content-Type':'application/json'},
+    body:JSON.stringify({name,spread_width_m:width,flow_rate_lpm:flow})
+  });
+  if(ok){ document.getElementById('irr-modal').style.display='none'; irrLoadSessions(); }
+}
+document.getElementById('irr-btn-end').addEventListener('click',async()=>{
+  if(!irrActiveSession) return;
+  await irrApi(`/sessions/${irrActiveSession}`,{
+    method:'PUT',headers:{'Content-Type':'application/json'},
+    body:JSON.stringify({end_time:new Date().toISOString()})
+  });
+  irrLoadSessions();
+});
+
+// ── API helper ────────────────────────────────────────────────────────
+async function irrApi(path,opts={}){
+  try{
+    const r=await fetch(IRR+path,{credentials:'include',...opts});
+    if(!r.ok) return null;
+    return r.json();
+  }catch(e){ return null; }
+}
