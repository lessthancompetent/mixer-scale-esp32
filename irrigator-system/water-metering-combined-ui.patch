+}
+
+// ── Sessions ─────────────────────────────────────────────────────────
+async function irrLoadSessions(){
+  const list=await irrApi('/sessions');
+  if(!list) return;
+  const sel=document.getElementById('irr-session-sel');
+  sel.innerHTML='<option value="">— select session —</option>';
+  list.forEach(s=>{
+    const o=document.createElement('option');
+    o.value=s.id;
+    const dt=s.start_time?s.start_time.slice(0,10):'';
+    o.text=(s.end_time===null?'▶ ':'')+`${s.name||'Session '+s.id} (${dt}) · ${s.point_count??0} pts`;
+    sel.appendChild(o);
+  });
+}
+document.getElementById('irr-session-sel').addEventListener('change',e=>{
+  const id=parseInt(e.target.value);
+  irrClearLayers();
+  irrActiveSession=id||null;
+  document.getElementById('irr-spread-card').classList.toggle('irr-hidden',!id);
+  if(id) irrLoadSessionData(id);
+});
+
+async function irrLoadSessionData(sid){
+  irrClearLayers();
+  const [posList,spData]=await Promise.all([
+    irrApi(`/sessions/${sid}/positions`),
+    irrApi(`/sessions/${sid}/spread`),
+  ]);
+  if(posList&&posList.length>=2) irrRenderTrack(posList);
+  if(spData&&spData.geojson)     irrRenderSpread(spData.geojson,spData.stats);
+  else                           irrShowStats(null);
+}
+
+function irrClearLayers(){
+  if(irrTrackLayer)  irrTrackLayer.clearLayers();
+  if(irrSpreadLayer) irrSpreadLayer.clearLayers();
+}
+
+// ── Track ────────────────────────────────────────────────────────────
+function irrRenderTrack(pts){
+  const lls=pts.map(p=>[p.lat,p.lon]);
+  const poly=L.polyline(lls,{color:'#fff',weight:2,opacity:.7,dashArray:'6 4'}).addTo(irrTrackLayer);
+  // Direction arrows
+  const step=Math.max(1,Math.floor(pts.length/20));
+  for(let i=step;i<pts.length;i+=step){
+    const a=pts[i-step],b=pts[i];
+    const ang=irrBearing([a.lat,a.lon],[b.lat,b.lon]);
+    const mid=[(a.lat+b.lat)/2,(a.lon+b.lon)/2];
+    L.marker(mid,{
+      icon:L.divIcon({html:`<div style="transform:rotate(${ang}deg);color:#fff;font-size:13px;line-height:1">▲</div>`,iconSize:[13,13],className:''}),
+      interactive:false
+    }).addTo(irrTrackLayer);
+  }
+  irrMap.fitBounds(poly.getBounds(),{padding:[40,40]});
+}
+function irrBearing(from,to){
+  const dL=(to[1]-from[1])*Math.PI/180;
+  const la=from[0]*Math.PI/180,lb=to[0]*Math.PI/180;
+  const y=Math.sin(dL)*Math.cos(lb);
+  const x=Math.cos(la)*Math.sin(lb)-Math.sin(la)*Math.cos(lb)*Math.cos(dL);
+  return((Math.atan2(y,x)*180/Math.PI)+360)%360;
+}
+
+// ── Spread polygon ────────────────────────────────────────────────────
+function irrRenderSpread(gj,stats){
+  L.geoJSON(gj,{
+    filter:f=>f.properties.type==='spread',
+    style:{color:'#2e7d32',fillColor:'#4caf50',fillOpacity:.35,weight:1.5},
+  }).bindTooltip(f=>{
+    const p=f.properties;
+    return `Area: ${p.area_ha} ha<br>Volume: ${(p.volume_l/1000).toFixed(1)} m³<br>`
+          +`Rate: ${p.app_rate_l_m2} L/m²<br>Depth: ${p.depth_mm} mm`;
+  }).addTo(irrSpreadLayer);
+  irrShowStats(stats);
+}
+function irrShowStats(s){
+  if(!s){['area','vol','rate','depth','dur'].forEach(k=>document.getElementById('irr-'+k).textContent='—');return;}
+  document.getElementById('irr-area').textContent =`${s.area_ha} ha`;
+  document.getElementById('irr-vol').textContent  =`${(s.volume_l/1000).toFixed(1)} m³`;
+  document.getElementById('irr-rate').textContent =`${s.app_rate_l_m2} L/m²`;
+  document.getElementById('irr-depth').textContent=`${s.depth_mm} mm`;
+  document.getElementById('irr-dur').textContent  =`${s.duration_min} min`;
+}
+
+// ── Alerts ────────────────────────────────────────────────────────────
+async function irrPollAlerts(){
+  const alerts=await irrApi('/alerts');
+  if(!alerts) return;
+  const list=document.getElementById('irr-alerts-list');
+  const cnt =document.getElementById('irr-alert-count');
+  if(irrAlertLayer) irrAlertLayer.clearLayers();
+  if(!alerts.length){
+    list.innerHTML='<span style="color:var(--muted);font-size:0.78rem">No active alerts</span>';
+    cnt.classList.add('irr-hidden'); return;
+  }
+  cnt.textContent=alerts.length; cnt.classList.remove('irr-hidden');
+  list.innerHTML='';
+  alerts.forEach(a=>{
+    if(a.lat&&a.lon&&irrAlertLayer){
+      L.circleMarker([a.lat,a.lon],{radius:10,color:'#ef4444',fillColor:'#ef4444',fillOpacity:.7,weight:2})
+        .bindPopup(`<b>STALL ALERT</b><br>${(a.timestamp||'').slice(0,16).replace('T',' ')}`)
+        .addTo(irrAlertLayer);
+    }
+    const loc=(a.lat&&a.lon)?`${a.lat.toFixed(5)}, ${a.lon.toFixed(5)}`:'Location unknown';
+    const div=document.createElement('div'); div.className='irr-alert-item';
+    div.innerHTML=`<div class="irr-alert-loc">⚠ IRRIGATOR STALLED</div>
+      <div class="irr-alert-time">${(a.timestamp||'').slice(0,16).replace('T',' ')} UTC</div>
+      <div style="font-size:0.7rem;color:var(--muted)">${loc}</div>
+      <button class="irr-btn irr-btn-gray" style="margin-top:4px;font-size:0.72rem;padding:2px 8px" onclick="irrAck(${a.id})">Acknowledge</button>`;
+    list.appendChild(div);
+  });
+}
+async function irrAck(id){ await irrApi(`/alerts/${id}/ack`,{method:'PUT'}); irrPollAlerts(); }
+
+// ── New session modal ─────────────────────────────────────────────────
