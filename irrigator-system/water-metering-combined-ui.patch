+// ── Live position ────────────────────────────────────────────────────
+async function irrPollLive(){
+  const pos=await irrApi('/live');
+  if(!pos){return;}
+  const pumpOn=pos.pump_on===1;
+  const spd=(pos.speed_cms/100).toFixed(1);
+  document.getElementById('irr-pump').textContent =pumpOn?'ON':'OFF';
+  document.getElementById('irr-pump').style.color =pumpOn?'#22c55e':'#ef4444';
+  document.getElementById('irr-speed').textContent=spd+' m/s';
+  document.getElementById('irr-batt').textContent =pos.battery_pct+'%';
+  document.getElementById('irr-time').textContent =
+    pos.timestamp ? new Date(pos.timestamp+'Z').toLocaleTimeString() : '—';
+  const badge=document.getElementById('irr-live-badge');
+  badge.textContent = pumpOn?'Pump ON':'GPS OK';
+  badge.className='irr-badge '+(pumpOn?'irr-badge-green':'irr-badge-amber');
+  if(irrMap){
+    const ll=[pos.lat,pos.lon];
+    if(!irrLiveMarker){
+      irrLiveMarker=L.circleMarker(ll,{radius:9,color:'#1e88e5',fillColor:'#42a5f5',fillOpacity:.9,weight:2})
+        .bindTooltip('Irrigator').addTo(irrMap);
+      irrMap.setView(ll,Math.max(irrMap.getZoom(),16));
+    } else { irrLiveMarker.setLatLng(ll); }
